-	if(target < (cur_power - 1200)) {
-		rfnm_fe_srb(dgb_dt, RFNM_GRANITA0_TX_T12I, 0);
-		//rfnm_fe_srb(dgb_dt, RFNM_GRANITA0_TX_T12O, 1);
