-int parse_granita_iq_lpf(int mhz) {
-	if(mhz >= 400) {
-		return 400000;
-	} else if(mhz >= 320) {
-		return 320000;
-	} else if(mhz >= 200) {
-		return 200000;
-	} else if(mhz >= 160) {
-		return 160000;
-	} else if(mhz >= 100) {
-		return 100000;
-	} else if(mhz >= 80) {
-		return 80000;
-	} else if(mhz >= 60) {
-		return 60000;
-	} else if(mhz >= 40) {
-		return 40000;
-	} else if(mhz >= 20) {
-		return 20000;
-	} else {
-		if(mhz >= 1) {
-			return 20000;
-		} else {
-			return 100000;
-		}
-	}
-}
