+		} else {
+			iqusb_reserved_mem_initialized = true;
+			iqusb_init_device = pcie_controller;
+			dev_info(la9310_dev->dev, "Initialized iqusb reserved memory region from parent\n");
+		}
+	} else {
+		dev_warn(la9310_dev->dev, "No parent device found for reserved memory init\n");
+		ret = -ENODEV;
+	}
+
+	// If parent init failed, try fallback with endpoint device
+	if (ret && !iqusb_reserved_mem_initialized) {
+		dev_info(la9310_dev->dev, "Attempting of_reserved_mem_device_init on endpoint...\n");
+		ret = of_reserved_mem_device_init(la9310_dev->dev);
+		dev_info(la9310_dev->dev, "Endpoint init returned: %d\n", ret);
+
+		if (ret) {
+			dev_warn(la9310_dev->dev, "Failed to init reserved memory: %d, trying normal DMA\n", ret);
+		} else {
+			iqusb_reserved_mem_initialized = true;
+			iqusb_init_device = la9310_dev->dev;
+			dev_info(la9310_dev->dev, "Initialized iqusb reserved memory region\n");
+		}
+	}
+	dev_info(la9310_dev->dev, "=== Reserved Memory Debug End ===\n");
+
+	// Allocate DMA-capable buffers (will use iqusb pool if available)
+	rfnm_rx_usb_buf = dma_alloc_coherent(la9310_dev->dev, buffer_size,
+					      &rfnm_rx_usb_buf_dma, GFP_KERNEL);
