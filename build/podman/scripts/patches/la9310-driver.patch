-void rfnm_rffc_shift_bit(struct rfnm_dgb *dgb_dt, uint32_t val, uint8_t size) {
-	for (uint8_t i = 0; i < size; i++) {
-		SCK_CLR;
-		if(!!(val & (1 << (size - 1 - i)))) {
-			rfnm_gpio_set(dgb_dt->dgb_id, RFNM_RFFC_DATA);
-		} else {
-			rfnm_gpio_clear(dgb_dt->dgb_id, RFNM_RFFC_DATA);
-		}
-		RFFC_DELAY;
-		SCK_SET;
-		RFFC_DELAY;
-	}
-}
