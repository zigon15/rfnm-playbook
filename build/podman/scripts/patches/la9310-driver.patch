+		if (iqusb_reserved_mem_initialized && iqusb_init_device)
+			of_reserved_mem_device_release(iqusb_init_device);
+		return -ENOMEM;
+	}
+
+	dev_info(la9310_dev->dev, "Allocated USB RX buffers: phys=0x%llx virt=%p size=%zu\n",
+			(u64)rfnm_rx_usb_buf_dma, rfnm_rx_usb_buf, buffer_size);
+
+	// Verify physical address matches M7 firmware expectations
+	if (rfnm_rx_usb_buf_dma < 0x9D400000 || rfnm_rx_usb_buf_dma > 0xA3400000) {
+		dev_warn(la9310_dev->dev,
+			 "WARNING: USB buffer at unexpected address 0x%llx (expected ~0x9D400000)\n",
+			 (u64)rfnm_rx_usb_buf_dma);
+		dev_warn(la9310_dev->dev, "This may cause M7/VSPA communication issues!\n");
+	}
 
 
 	//rfnm_rx_usb_buf = kzalloc((sizeof(struct rfnm_rx_usb_buf) * RFNM_RX_USB_BUF_SIZE), GFP_KERNEL);
@@ -1979,7 +2058,19 @@ static void  __exit la9310_rfnm_exit(void)
 
