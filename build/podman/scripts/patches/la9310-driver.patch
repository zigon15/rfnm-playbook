-		//rfnm_fe_srb(dgb_dt, RFNM_GRANITA0_TX_T12O, 0);
-	}
-	
-	if(target < (cur_power - 600)) {
-		rfnm_fe_srb(dgb_dt, RFNM_GRANITA0_TX_T6I, 0);
