-						0x96400000 +  (sizeof(struct rfnm_bufdesc_rx) * RFNM_ADC_BUFCNT) + SZ_64M, 
-						sizeof(struct rfnm_rx_usb_buf) * RFNM_RX_USB_BUF_SIZE, MEMREMAP_WB);
+	size_t buffer_size = sizeof(struct rfnm_rx_usb_buf) * RFNM_RX_USB_BUF_SIZE;
+	int ret;
+
+	// DEBUG: Detailed device tree and reserved memory investigation
+	dev_info(la9310_dev->dev, "=== Reserved Memory Debug Start ===\n");
+	dev_info(la9310_dev->dev, "Endpoint device: %s (of_node=%p)\n",
+		dev_name(la9310_dev->dev), la9310_dev->dev->of_node);
+
+	// Initialize reserved memory using parent PCIe controller device
+	// The PCIe endpoint (la9310_dev->dev) doesn't have memory-region in DT,
+	// but its parent PCIe controller does. Use parent for reservation.
+	struct device *pcie_controller = la9310_dev->dev->parent;
+	if (pcie_controller) {
+		dev_info(la9310_dev->dev, "Parent device: %s (of_node=%p)\n",
+			dev_name(pcie_controller), pcie_controller->of_node);
+
+		if (pcie_controller->of_node) {
+			struct property *prop = of_find_property(pcie_controller->of_node,
+								  "memory-region", NULL);
+			dev_info(la9310_dev->dev, "Parent has memory-region property: %s\n",
+				prop ? "YES" : "NO");
+		}
+
+		dev_info(la9310_dev->dev, "Attempting of_reserved_mem_device_init on parent...\n");
+		ret = of_reserved_mem_device_init(pcie_controller);
+		dev_info(la9310_dev->dev, "Parent init returned: %d\n", ret);
 
-	dev_info(la9310_dev->dev, "Mapped rfnm_rx_usb_buf from %x to %lx size %d\n", 
-			0x96400000 +  (sizeof(struct rfnm_bufdesc_rx) * RFNM_ADC_BUFCNT) + SZ_64M, 
-			rfnm_rx_usb_buf, sizeof(struct rfnm_rx_usb_buf) * RFNM_RX_USB_BUF_SIZE);
+		if (ret) {
