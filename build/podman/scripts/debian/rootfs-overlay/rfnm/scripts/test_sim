
# pwm2 is used as both nano-sim clock and sn220 reset signal

echo 0 > /sys/class/pwm/pwmchip0/export
echo 1 > /sys/class/pwm/pwmchip0/pwm0/enable
echo 1000 > /sys/class/pwm/pwmchip0/pwm0/period
echo 500 > /sys/class/pwm/pwmchip0/pwm0/duty_cycle
echo 1000 > /sys/class/pwm/pwmchip0/pwm0/period
echo 500 > /sys/class/pwm/pwmchip0/pwm0/duty_cycle

gpioset 4 27=1 #shutdown sn220

gpioget 4 28
gpioget 4 29
gpioset 0 0=1 # power reset
gpioset 0 15=0 # iso reset
sleep 1
gpioset 0 0=0

sleep 1

gpioset 0 15=1
