
echo on > /sys/kernel/rfnm_primary/rx1/enable
echo loopback > /sys/kernel/rfnm_primary/rx1/path
echo 2350000000 > /sys/kernel/rfnm_primary/rx1/freq
echo 100 > /sys/kernel/rfnm_primary/rx1/iq_lpf_bw
echo 40 > /sys/kernel/rfnm_primary/rx1/gain

echo 1 > /sys/kernel/rfnm_primary/rx1/apply


echo on > /sys/kernel/rfnm_primary/tx0/enable
echo loopback > /sys/kernel/rfnm_primary/tx0/path
echo 2355000000 > /sys/kernel/rfnm_primary/tx0/freq
echo 100 > /sys/kernel/rfnm_primary/tx0/iq_lpf_bw
echo 100 > /sys/kernel/rfnm_primary/tx0/power

echo 1 > /sys/kernel/rfnm_primary/tx0/apply
