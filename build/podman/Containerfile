FROM ubuntu:25.10

# Avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install required dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    crossbuild-essential-arm64 \
    bison \
    flex \
    bc \
    libssl-dev \
    libncurses-dev \
    python3-dev \
    python3-setuptools \
    swig \
    git \
    device-tree-compiler \
    lzop \
    wget \
    kmod \
    uuid-dev \
    libgnutls28-dev \
    fdisk \
    parted \
    u-boot-tools \
    dosfstools \
    rsync \
    udev \
    && rm -rf /var/lib/apt/lists/*

# Install dependancies for creating Debian root filesystem
RUN apt-get update && apt-get install -y \
    debootstrap \
    debian-archive-keyring \
    && rm -rf /var/lib/apt/lists/*

# Download and install qemu-aarch64-static for cross-architecture builds
RUN wget https://github.com/multiarch/qemu-user-static/releases/latest/download/qemu-aarch64-static && \
    chmod +x qemu-aarch64-static && \
    mv qemu-aarch64-static /usr/bin/

# Set the working directory
WORKDIR /work/scripts

# Set environment variables for Cross-Compilation
ENV ARCH=arm64
ENV CROSS_COMPILE=aarch64-linux-gnu-

# Default command matches your shell
CMD ["/bin/bash"]