FROM ubuntu:25.10

# Avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies for building U-Boot and Linux Kernel
# 'crossbuild-essential-arm64' installs gcc-aarch64-linux-gnu automatically
RUN apt-get update && apt-get install -y \
    build-essential \
    crossbuild-essential-arm64 \
    bison \
    flex \
    bc \
    libssl-dev \
    libncurses-dev \
    python3-dev \
    python3-setuptools \
    swig \
    git \
    device-tree-compiler \
    lzop \
    wget \
    uuid-dev \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y libgnutls28-dev

# Set the working directory
WORKDIR /work

# Set environment variables for Cross-Compilation
ENV ARCH=arm64
ENV CROSS_COMPILE=aarch64-linux-gnu-

# Default command matches your shell
CMD ["/bin/bash"]