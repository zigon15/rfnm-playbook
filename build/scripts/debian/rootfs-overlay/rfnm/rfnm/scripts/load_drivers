# Source build-time config, with defaults
if [ -f /rfnm/scripts/rfnm-build.conf ]; then
    . /rfnm/scripts/rfnm-build.conf
fi
: "${USB_A_MODE:=device}"

#dump kernel messages to console
echo 7 > /proc/sys/kernel/printk

# those are for debugging
#gpioset 3 5=1
#gpioset 3 4=1
#gpioset 3 6=1
#gpioset 3 7=1

# disable power to usb-a
gpioset 2 6=1

#enable boost device (skip in host mode to avoid crash)
if [ "$USB_A_MODE" != "host" ]; then
    echo "device" > /sys/kernel/debug/usb/38200000.usb/mode
fi

# m4 jtag enable
gpioget 2 9
gpioget 2 14

/rfnm/scripts/enable_la9310_uart_ext_port

#pcie hack
set +x
memtool -32 0x33B00214=0x10000000
setpci -s 01:00.0 COMMAND=0x02
memtool -32 0x1b401010=0x03FFFFFF
memtool -32 0x1b400010=0x18000000
memtool -32 0x33B00214=0x18000000

#lspci -vv | grep Addr

insmod /rfnm/kernel/la9310shiva.ko scratch_buf_size=0x4000000 scratch_buf_phys_addr=0x92400000 
insmod /rfnm/kernel/kpage_ncache.ko
insmod /rfnm/kernel/rfnm_gpio.ko
insmod /rfnm/kernel/la9310rfnm.ko


insmod /rfnm/kernel/rfnm_lalib.ko
insmod /rfnm/kernel/rfnm_daughterboard.ko

insmod /rfnm/kernel/rfnm_usb_function.ko
insmod /rfnm/kernel/rfnm_usb.ko file=/rfnm/scripts/backing_storage
if [ "$USB_A_MODE" != "host" ]; then
    insmod /rfnm/kernel/rfnm_usb_boost.ko file=/rfnm/scripts/backing_storage_boost
fi

insmod /rfnm/kernel/rfnm_lime.ko
insmod /rfnm/kernel/rfnm_granita.ko
insmod /rfnm/kernel/rfnm_breakout.ko

echo -n "rfnm_m7_v0.elf" > /sys/class/remoteproc/remoteproc0/firmware
echo stop > /sys/class/remoteproc/remoteproc0/state
echo start > /sys/class/remoteproc/remoteproc0/state

memtool 0x303D0968=0xff
